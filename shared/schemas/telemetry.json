{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bess/telemetry",
  "title": "BESS Telemetry Payload",
  "type": "object",
  "required": ["ts", "device_id", "battery_soc_pct", "pv_power_w", "grid_power_w"],
  "properties": {
    "ts":               { "type": "string", "format": "date-time" },
    "device_id":        { "type": "string", "minLength": 1 },
    "sequence_num":     { "type": "integer", "minimum": 0 },
    "pv_power_w":       { "type": "number", "minimum": 0 },
    "wind_power_w":     { "type": "number", "minimum": 0 },
    "battery_power_w":  { "type": "number" },
    "grid_power_w":     { "type": "number" },
    "house_load_w":     { "type": "number", "minimum": 0 },
    "battery_soc_pct":  { "type": "number", "minimum": 0, "maximum": 100 },
    "battery_soh_pct":  { "type": "number", "minimum": 0, "maximum": 100 },
    "battery_temp_c":   { "type": "number" },
    "battery_voltage_v":{ "type": "number", "minimum": 0 },
    "battery_current_a":{ "type": "number" },
    "grid_status":      { "type": "string", "enum": ["CONNECTED","DISCONNECTED","UNSTABLE"] },
    "grid_voltage_v":   { "type": "number", "minimum": 0 },
    "grid_frequency_hz":{ "type": "number", "minimum": 45, "maximum": 55 },
    "inverter_temp_c":  { "type": "number" },
    "inverter_mode":    { "type": "string" },
    "fault_code":       { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
